{
  "dxt_version": "0.2",
  "name": "strezless-musick-nexus-metadata-mcp",
  "version": "0.0.1",
  "description": "The official MCP Server for the Strezless Musick Nexus Metadata API",
  "author": {
    "name": "Strezless Musick Nexus Metadata"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omar-orrantia/GDL_code.git"
  },
  "homepage": "https://github.com/omar-orrantia/GDL_code/tree/main/packages/mcp-server#readme",
  "server": {
    "type": "node",
    "entry_point": "index.js",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/index.js"],
      "env": {
        "STREZLESS_MUSICK_NEXUS_METADATA_API_KEY": "${user_config.STREZLESS_MUSICK_NEXUS_METADATA_API_KEY}"
      }
    }
  },
  "user_config": {
    "STREZLESS_MUSICK_NEXUS_METADATA_API_KEY": {
      "title": "api_key",
      "description": "",
      "required": true,
      "type": "string"
    }
  },
  "tools": [],
  "tools_generated": true,
  "compatibility": {
    "runtimes": {
      "node": ">=18.0.0"
    }
  },
  "keywords": ["api"]
}
